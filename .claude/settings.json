{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make data)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make numbers)",
      "Bash(make book)",
      "Bash(make all)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(make results)",
      "Bash(git tag -l *)"
    ],
    "deny": [
      "Read(./data/phi/**)",
      "Edit(./data/raw/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && Rscript scripts/check_inline_numbers.R >&2 || exit 2"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/check_plan_change.sh"
          }
        ]
      }
    ]
  }
}
